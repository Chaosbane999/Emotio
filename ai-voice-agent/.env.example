# Which engine runs calls:
#   openai = speech-to-speech with OpenAI Realtime (ChatGPT-style voice, best interruptions)
#   claude = Claude + ElevenLabs voice via Twilio ConversationRelay
VOICE_ENGINE=openai

# OpenAI (platform.openai.com/api-keys) - needed for VOICE_ENGINE=openai
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# marin (female) or cedar (male) are OpenAI's best voices; also alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_VOICE=marin
OPENAI_VOICE_SPEED=1.0
OPENAI_REASONING_EFFORT=low
# semantic_vad waits for the caller to finish their thought; server_vad reacts faster to silence
OPENAI_TURN_DETECTION=semantic_vad

# Anthropic - needed for VOICE_ENGINE=claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low keeps replies fast for live phone calls; raise for harder tasks
CLAUDE_EFFORT=low

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The Twilio number the agent calls from / answers on (E.164)
TWILIO_PHONE_NUMBER=+447700900123

# Public HTTPS URL of this server (e.g. your ngrok URL), no trailing slash
PUBLIC_BASE_URL=https://example.ngrok.app
PORT=8080

# Protects POST /calls (send as "Authorization: Bearer <key>")
API_KEY=change-me
# Set to false only for local testing without Twilio signatures
VALIDATE_TWILIO_SIGNATURE=true

# Agent persona
AGENT_NAME=Ava
AGENT_GREETING=Hi, this is Ava, an AI assistant. How can I help you today?
# Optional: extra instructions appended to the system prompt
AGENT_INSTRUCTIONS=
# Claude engine voice (ElevenLabs via Twilio ConversationRelay - no ElevenLabs account needed)
TTS_PROVIDER=ElevenLabs
# Voice ID. Default is "Alice" (friendly, British). Pick others from Twilio's
# ConversationRelay voice list or the ElevenLabs voice library (filter by accent: British).
TTS_VOICE=Xb7hH8MSUJpSbSDYk0k2
# flash_v2_5 = lowest latency (best for calls); turbo_v2_5 = slightly richer
TTS_MODEL=flash_v2_5
# Speed 0.7-1.2, stability/similarity 0-1. Lower stability = more expressive.
TTS_SPEED=1.0
TTS_STABILITY=0.45
TTS_SIMILARITY=0.8
LANGUAGE=en-GB
